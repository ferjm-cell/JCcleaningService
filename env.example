# Cleaning Multi Service JC — environment template
# Copy to .env and fill in. NEVER commit .env.

# ── core ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/cmsjc

# ── sessions & encryption ────────────────────────────
SESSION_SECRET=
# 32-byte key, base64, used to encrypt integration tokens at rest
TOKEN_ENCRYPTION_KEY=

# ── owner bootstrap (first run only) ─────────────────
OWNER_EMAIL=
OWNER_PASSWORD=

# ── Google: Gmail, Drive, Calendar, Docs ─────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ── DocuSign (JWT grant) ─────────────────────────────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_WEBHOOK_SECRET=

# ── Stripe ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── feature flags ────────────────────────────────────
FEATURE_PAYMENTS=false
FEATURE_AUTOMATIONS=false
FEATURE_AI_ASSISTANT=false
FEATURE_CUSTOMER_PORTAL=false
FEATURE_EMPLOYEE_PORTAL=false
